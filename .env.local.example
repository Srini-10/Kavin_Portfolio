# Environment variables for the contact form's /api/contact route.
#
# LOCAL DEV:  copy this file to `.env.local` and fill in real values.
# PRODUCTION: set the SAME variables in Vercel
#             (Project → Settings → Environment Variables), then redeploy.
#
# These are SERVER-SIDE only (no NEXT_PUBLIC_ prefix), so they are never exposed
# to the browser.

# ---- REQUIRED ----
# Gmail account that sends the emails (authenticated SMTP account).
EMAIL_USER=your-gmail-address@gmail.com
# Gmail App Password (16 chars) for EMAIL_USER — https://myaccount.google.com/apppasswords
EMAIL_PASS=your-16-char-app-password

# ---- OPTIONAL ----
# Where admin notification emails are delivered (defaults to EMAIL_USER).
CONTACT_RECIPIENT=kavinkumars773@gmail.com
# Display name used in the "from" field and email templates.
BRAND_NAME=Kavinkumar S.

# ---- OPTIONAL: only if you host the backend somewhere other than this app ----
# The form posts to the same-origin "/api/contact" by default. Set this to an
# absolute URL only to point the form at an external backend instead.
# NEXT_PUBLIC_CONTACT_ENDPOINT=
